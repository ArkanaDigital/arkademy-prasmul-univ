<odoo>
    <record id="view_academy_batch_list" model="ir.ui.view">
        <field name="name">academy.batch.list</field>
        <field name="model">academy.batch</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="course_id"/>
                <field name="start_date"/>
                <field name="state"/>
                <field name="enrollment_count"/>
                <field name="available_seats"/>
            </list>
        </field>
    </record>

    <record id="view_academy_batch_form" model="ir.ui.view">
        <field name="name">academy.batch.form</field>
        <field name="model">academy.batch</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="course_id"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="capacity"/>
                            <field name="enrollment_count"/>
                            <field name="available_seats"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Enrollments">
                            <field name="enrollment_ids">
                                <list editable="bottom">
                                    <field name="student_id"/>
                                    <field name="enrollment_date"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_academy_batch_search" model="ir.ui.view">
        <field name="name">academy.batch.search</field>
        <field name="model">academy.batch</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="course_id"/>
                <filter name="draft" string="Draft"
                        domain="[('state','=','draft')]"/>
                <group>
                    <filter name="grp_course" string="Course"
                            context="{'group_by':'course_id'}"/>
                    <filter name="grp_state" string="State"
                            context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_academy_batch" model="ir.actions.act_window">
        <field name="name">Batches</field>
        <field name="res_model">academy.batch</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
