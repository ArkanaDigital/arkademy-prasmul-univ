<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- tampilan untuk list view -->
    <record id="view_academy_course_list" model="ir.ui.view">
        <field name="name">academy.course.list</field>
        <field name="model">academy.course</field>
        <field name="arch" type="xml">
            <list string="Courses">
                <field name="id"/>
                <field name="code"/>
                <field name="name"/>
                <field name="level"/>
                <field name="duration_hours" sum="Total Jam"/>
                <field name="price" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- tampilan untuk form view -->
    <record id="view_academy_course_form" model="ir.ui.view">
        <field name="name">academy.course.form</field>
        <field name="model">academy.course</field>
        <field name="arch" type="xml">
            <form string="Course">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nama course"/></h1>
                    </div>
                    <group>
                        <group string="Informasi">
                            <field name="code"/>
                            <field name="level"/>
                            <field name="active"/>
                        </group>
                        <group string="Durasi &amp; Biaya">
                            <field name="duration_hours"/>
                            <field name="price"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Deskripsi">
                            <field name="description"/>
                        </page>
                        <page string="Catatan">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_academy_course_search" model="ir.ui.view">
        <field name="name">academy.course.search</field>
        <field name="model">academy.course</field>
        <field name="arch" type="xml">
            <search string="Cari Course">
                <field name="name"/>
                <field name="code"/>
                <field name="note"/>
                <filter name="beginner" string="Beginner"
                        domain="[('level','=','beginner')]"/>
                <filter name="advanced" string="Advanced"
                        domain="[('level','=','advanced')]"/>
                <filter name="beginner-intermediate" string="Beginer &amp; Intermediate"
                        domain="[('level', 'in', ('beginner', 'intermediate'))]"/>
                <filter name="beginner-advance" string="Beginer &amp; Advanced"
                        domain="[('level', 'in', ('beginner', 'advanced'))]"/>
                <separator/>
                <filter name="inactive" string="Archived"
                        domain="[('active','=',False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_level" string="Level"
                            context="{'group_by': 'level'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_academy_course" model="ir.actions.act_window">
        <field name="name">Courses</field>
        <field name="res_model">academy.course</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>