<odoo>
    <record id="action_report_enrollment_certificate" model="ir.actions.report">
        <field name="name">Enrollment Certificate</field>
        <field name="model">academy.enrollment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">academy_management.report_enrollment_certificate</field>
        <field name="report_file">academy_management.report_enrollment_certificate</field>
        <field name="binding_model_id" ref="model_academy_enrollment"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_enrollment_certificate_formatted" model="ir.actions.report">
        <field name="name">Enrollment Certificate - Formatted</field>
        <field name="model">academy.enrollment</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">academy_management.report_enrollment_certificate_formatted</field>
        <field name="report_file">academy_management.report_enrollment_certificate_formatted</field>
        <field name="binding_model_id" ref="model_academy_enrollment"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_enrollment_certificate">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <!-- <h1><t t-esc="doc"/></h1> -->
                        <h2 class="text-center">Certificate of Enrollment</h2>
                        <div class="mt32">
                            <p>Student: <span t-field="doc.student_id.name"/></p>
                            <p>Course: <span t-field="doc.batch_id.course_id.name"/></p>
                            <p>Batch: <span t-field="doc.batch_id.name"/></p>
                            <p>Enrollment Date: <span t-field="doc.enrollment_date"/></p>
                            <p>State: <span t-field="doc.state"/></p>
                            <p>Generated: <span t-esc="time.strftime('%Y-%m-%d')"/></p>
                        </div>
                        <div>
                            <table>
                                <tr>
                                    <th>No</th>
                                    <th>Name</th>
                                </tr>
                                <t t-foreach="doc.batch_id.enrollment_ids" t-as="batch">
                                    <tr>
                                        <td>*</td>
                                        <td><span t-field="batch.student_id.name"/></td>
                                    </tr>
                                </t>
                            </table>
                            <!-- <p>Attendees: <span t-esc="doc.enrollment_ids"/></p> -->
                        </div>
                        <div class="mt32">
                            <p><strong>Generated by Arkana Academy</strong></p>
                            <p>Trainer Signature: ____________________</p>
                            <p>Certificate Reference: <span t-esc="doc.id"/></p>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_enrollment_certificate_formatted">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <style>
                        .cert-container {
                            border: 8px double #2c3e50;
                            padding: 50px 40px;
                            background-color: #ffffff;
                            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
                            color: #333333;
                            border-radius: 4px;
                            margin-top: 20px;
                        }
                        .cert-header {
                            text-transform: uppercase;
                            letter-spacing: 3px;
                            color: #7f8c8d;
                            font-size: 16px;
                            font-weight: bold;
                        }
                        .cert-title {
                            font-family: 'Georgia', serif;
                            font-size: 36px;
                            color: #2c3e50;
                            margin-top: 25px;
                            margin-bottom: 35px;
                            font-weight: bold;
                            text-transform: uppercase;
                        }
                        .cert-body {
                            font-size: 18px;
                            line-height: 1.8;
                            margin-bottom: 40px;
                        }
                        .cert-recipient {
                            font-family: 'Georgia', serif;
                            font-size: 32px;
                            font-style: italic;
                            color: #16a085;
                            font-weight: bold;
                            border-bottom: 2px solid #bdc3c7;
                            display: inline-block;
                            padding-bottom: 5px;
                            margin: 15px 0;
                            width: 80%;
                        }
                        .cert-course {
                            font-size: 24px;
                            color: #2c3e50;
                            font-weight: bold;
                            margin-top: 10px;
                        }
                        .cert-footer {
                            margin-top: 60px;
                            border-top: 1px dashed #e2e8f0;
                            padding-top: 30px;
                        }
                        .signature-section {
                            text-align: right;
                        }
                        .signature-line {
                            border-top: 1px solid #7f8c8d;
                            margin-top: 60px;
                            display: inline-block;
                            width: 220px;
                        }
                        .meta-info {
                            text-align: left;
                            font-size: 13px;
                            color: #7f8c8d;
                            line-height: 1.6;
                        }
                    </style>

                    <div class="page">
                        <div class="cert-container text-center">
                            
                            <div class="cert-header">
                                <span>Arkana Academy</span>
                            </div>

                            <div class="cert-title">
                                Certificate of Enrollment
                            </div>

                            <div class="cert-body">
                                <p class="mb0">This is to officially certify that</p>
                                
                                <div class="cert-recipient">
                                    <span t-field="doc.student_id.name"/>
                                </div>
                                
                                <p class="mt16 mb0">has successfully registered and is enrolled in the course</p>
                                
                                <div class="cert-course">
                                    <span t-field="doc.batch_id.course_id.name"/>
                                </div>
                                
                                <p class="text-muted" style="font-size: 16px;">
                                    Batch: <span t-field="doc.batch_id.name"/> 
                                    <t t-if="doc.state">
                                        | Status: <span t-field="doc.state" style="text-transform: capitalize; font-weight: bold; color: #2e7d32;"/>
                                    </t>
                                </p>
                            </div>

                            <div class="cert-footer row">
                                <div class="col-6 meta-info">
                                    <p class="mb4"><strong>Enrollment Date:</strong> <span t-field="doc.enrollment_date" t-options='{"widget": "date"}'/></p>
                                    <p class="mb4"><strong>Certificate Ref:</strong> #<span t-esc="doc.id"/></p>
                                    <p class="mb0"><strong>Issued On:</strong> <span t-esc="time.strftime('%Y-%m-%d')"/></p>
                                </div>
                                
                                <div class="col-6 signature-section">
                                    <div class="signature-line"></div>
                                    <p class="mt8 mb0" style="font-size: 14px; font-weight: bold; color: #2c3e50;">Trainer Signature</p>
                                    <p class="text-muted" style="font-size: 12px;">Arkana Academy Authorised Signatory</p>
                                </div>
                            </div>

                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>