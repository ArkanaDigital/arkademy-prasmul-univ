<odoo>
    <record id="view_academy_enrollment_list" model="ir.ui.view">
        <field name="name">academy.enrollment.list</field>
        <field name="model">academy.enrollment</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button
                        string="Reject Enrollment"
                        name="%(academy_management.action_reject_enrollment_wizard)d"
                        type="action"
                        class="btn-secondary"/>
                </header>
                <field name="name"/>
                <field name="batch_id"/>
                <field name="student_id"/>
                <field name="enrollment_date"/>
                <field name="state" string="Status"
                        decoration-success="state == 'confirmed'"
                        decoration-info="state == 'manager_approved'"
                        decoration-primary="state == 'submitted'"
                        widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_academy_enrollment_form" model="ir.ui.view">
        <field name="name">academy.enrollment.form</field>
        <field name="model">academy.enrollment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_manager_approve" type="object"
                            string="Level 1 Approve" class="btn-primary"
                            groups="academy_management.academy_group_approval_l1"
                            invisible="state != 'submitted'"/>
                    <button name="action_final_approve" type="object"
                            string="Final Approve" class="btn-primary"
                            groups="academy_management.academy_group_approval_l2"
                            invisible="state != 'manager_approved'"/>
                    <button name="action_done" type="object" string="Mark as Done"
                            invisible="state != 'confirmed'"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state not in ('submitted', 'manager_approved')"/>
                    <button name="action_reset_to_draft" type="object"
                            string="Reset to Draft"
                            invisible="state not in ('rejected', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                            statusbar_visible="draft,submitted,manager_approved,confirmed,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="batch_id"/>
                            <field name="student_id"/>
                        </group>
                        <group>
                            <field name="enrollment_date"/>
                            <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                        <page string="Approval Info">
                            <group>
                                <field name="submitted_by_id"/>
                                <field name="submitted_date"/>
                                <field name="manager_approved_by_id"/>
                                <field name="manager_approved_date"/>
                                <field name="final_approved_by_id"/>
                                <field name="final_approved_date"/>
                                <field name="rejection_reason"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_academy_enrollment_graph" model="ir.ui.view">
        <field name="name">academy.enrollment.graph</field>
        <field name="model">academy.enrollment</field>
        <field name="arch" type="xml">
            <graph type="bar">
                <field name="state"/>
            </graph>
        </field>
    </record>

    <record id="view_academy_enrollment_search" model="ir.ui.view">
        <field name="name">academy.enrollment.search</field>
        <field name="model">academy.enrollment</field>
        <field name="arch" type="xml">
            <search>
                <field name="batch_id"/>
                <field name="student_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="confirmed" string="Confirmed"
                        domain="[('state','=','confirmed')]"/>
                <group>
                    <filter name="grp_state" string="State"
                            context="{'group_by':'state'}"/>
                    <filter name="grp_batch" string="Batch"
                            context="{'group_by':'batch_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_academy_enrollment" model="ir.actions.act_window">
        <field name="name">Enrollments</field>
        <field name="res_model">academy.enrollment</field>
        <field name="view_mode">list,form,graph</field>
    </record>
</odoo>