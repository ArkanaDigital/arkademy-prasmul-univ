<odoo>
    <record id="view_academy_batch_list" model="ir.ui.view">
        <field name="name">academy.batch.list</field>
        <field name="model">academy.batch</field>
        <field name="arch" type="xml">
            <list decoration-info="state=='draft'"
                  decoration-success="state=='confirmed'"
                  decoration-muted="state=='cancelled'">
                <field name="name"/>
                <field name="code"/>
                <field name="course_id"/>
                <field name="responsible_id"/>
                <field name="start_date"/>
                <field name="enrollment_count"/>
                <field name="available_seats"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_academy_batch_form" model="ir.ui.view">
        <field name="name">academy.batch.form</field>
        <field name="model">academy.batch</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="course_id"/>
                            <field name="responsible_id"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="capacity"/>
                            <field name="enrollment_count"/>
                            <field name="available_seats"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Enrollments">
                            <field name="enrollment_ids">
                                <list editable="bottom">
                                    <field name="student_id"/>
                                    <field name="enrollment_date"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_academy_batch_calendar" model="ir.ui.view">
        <field name="name">academy.batch.calendar</field>
        <field name="model">academy.batch</field>
        <field name="arch" type="xml">
            <calendar date_start="start_date" date_stop="end_date" color="course_id">
                <field name="name"/>
            </calendar>
        </field>
    </record>

    <record id="view_academy_batch_kanban" model="ir.ui.view">
        <field name="name">academy.batch.kanban</field>
        <field name="model">academy.batch</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="course_id"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <strong><field name="name"/></strong>
                        <div><field name="course_id"/></div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_academy_batch_search" model="ir.ui.view">
        <field name="name">academy.batch.search</field>
        <field name="model">academy.batch</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="course_id"/>
                <filter name="draft" string="Draft"
                        domain="[('state','=','draft')]"/>
                <group>
                    <filter name="grp_course" string="Course"
                            context="{'group_by':'course_id'}"/>
                    <filter name="grp_state" string="State"
                            context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_academy_batch" model="ir.actions.act_window">
        <field name="name">Batches</field>
        <field name="res_model">academy.batch</field>
        <field name="view_mode">list,form,kanban,calendar</field>
    </record>
</odoo>