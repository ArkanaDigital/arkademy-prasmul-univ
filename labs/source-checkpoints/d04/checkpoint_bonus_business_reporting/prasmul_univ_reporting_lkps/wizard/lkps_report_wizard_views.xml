<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lkps_report_wizard_form" model="ir.ui.view">
        <field name="name">prasmul.univ.lkps.report.wizard.form</field>
        <field name="model">prasmul.univ.lkps.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Laporan Finansial LKPS Parsial">
                <group>
                    <field name="company_id" options="{'no_create': True}"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <div class="alert alert-warning" role="alert">
                    Dataset ini hanya mencakup data finansial untuk persiapan dan pelatihan, bukan pengajuan LKPS lengkap.
                </div>
                <field name="output_file" invisible="1"/>
                <field name="output_filename" invisible="1"/>
                <footer>
                    <button name="action_export" string="Ekspor XLSX" type="object" class="btn-primary"/>
                    <button string="Batal" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_lkps_report_wizard" model="ir.actions.act_window">
        <field name="name">LKPS Parsial</field>
        <field name="res_model">prasmul.univ.lkps.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_lkps_report"
              name="LKPS Parsial"
              parent="prasmul_univ_reporting.menu_business_reporting_root"
              action="action_lkps_report_wizard"
              groups="prasmul_univ_reporting.group_business_reporting_user"
              sequence="10"/>
</odoo>
