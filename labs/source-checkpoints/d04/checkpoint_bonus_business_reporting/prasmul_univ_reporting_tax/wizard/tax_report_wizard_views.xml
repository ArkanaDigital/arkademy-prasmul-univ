<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tax_report_wizard_form" model="ir.ui.view">
        <field name="name">prasmul.univ.tax.report.wizard.form</field>
        <field name="model">prasmul.univ.tax.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Laporan Pajak Operasional">
                <group>
                    <field name="company_id" options="{'no_create': True}"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <div class="alert alert-info" role="alert">
                    Workbook ini membantu peninjauan operasional dan tidak menggantikan pelaporan pajak resmi.
                </div>
                <field name="output_file" invisible="1"/>
                <field name="output_filename" invisible="1"/>
                <footer>
                    <button name="action_export" string="Ekspor XLSX" type="object" class="btn-primary"/>
                    <button string="Batal" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_tax_report_wizard" model="ir.actions.act_window">
        <field name="name">Laporan Pajak</field>
        <field name="res_model">prasmul.univ.tax.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_tax_report"
              name="Laporan Pajak"
              parent="prasmul_univ_reporting.menu_business_reporting_root"
              action="action_tax_report_wizard"
              groups="prasmul_univ_reporting.group_business_reporting_user"
              sequence="20"/>
</odoo>
