<odoo>
    <record id="view_academy_batch_form_domain" model="ir.ui.view">
        <field name="name">academy.batch.form.domain</field>
        <field name="model">academy.batch</field>
        <field name="inherit_id"
               ref="academy_management.view_academy_batch_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='course_id']" position="attributes">
                <attribute name="domain">[('active', '=', True)]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
